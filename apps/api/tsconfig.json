{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "target": "ES2022",
    "sourceMap": true,

    "outDir": "./dist",
    "rootDir": "./src",

    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "types": ["node"]
  },

  "include": ["src/**/*.ts"]
}