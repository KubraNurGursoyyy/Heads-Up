generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NotificationMode {
  IMPORTANT_ONLY
  ALL_RELEVANT
  SELECTED_EVENTS
  OFF
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  devices      Device[]
  watches      Watch[]
  notifications Notification[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Device {
  id            String   @id @default(cuid())
  userId        String
  expoPushToken String   @unique
  platform      String   @default("android")
  deviceName    String?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Watch {
  id                  String           @id @default(cuid())
  userId              String
  prompt              String
  topic               String
  intent              String
  category            String
  requiredTerms       Json             @default("[]")
  aliases             Json
  searchQueries       Json
  notifyEvents        Json
  notificationMode    NotificationMode @default(IMPORTANT_ONLY)
  importanceThreshold Float            @default(0.72)
  active              Boolean          @default(true)
  lastCheckedAt       DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchArticles WatchArticle[]
  notifications Notification[]
  @@index([userId, active])
}

model Article {
  id           String   @id @default(cuid())
  canonicalUrl String   @unique
  fingerprint  String   @unique
  title        String
  description  String?
  sourceName   String?
  sourceType   String
  imageUrl     String?
  publishedAt  DateTime?
  discoveredAt DateTime @default(now())
  watchArticles WatchArticle[]
  notifications Notification[]
  @@index([publishedAt])
}

model WatchArticle {
  id               String   @id @default(cuid())
  watchId          String
  articleId        String
  relevanceScore   Float
  importanceScore  Float
  isNewInformation Boolean
  eventType        String?
  eventKey         String?
  summary          String
  readAt           DateTime?
  createdAt        DateTime @default(now())
  watch   Watch   @relation(fields: [watchId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  @@unique([watchId, articleId])
  @@index([watchId, createdAt])
  @@index([watchId, eventKey])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  watchId   String
  articleId String
  eventKey  String
  url       String
  title     String
  body      String
  status    NotificationStatus @default(PENDING)
  error     String?
  sentAt    DateTime?
  createdAt DateTime           @default(now())
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  watch   Watch   @relation(fields: [watchId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  @@unique([watchId, articleId])
  @@unique([watchId, eventKey])
  @@index([userId, createdAt])
}


model PolicySnapshot {
  id          String   @id @default(cuid())
  service     String   @unique
  url         String
  fingerprint String
  excerpt     String
  checkedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemAlert {
  id        String   @id @default(cuid())
  eventKey  String   @unique
  title     String
  body      String
  url       String
  createdAt DateTime @default(now())
}
