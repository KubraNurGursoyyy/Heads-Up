# API
PORT=3000
DATABASE_URL=postgresql://headsup:headsup@localhost:5432/headsup?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=change-me-with-a-long-random-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30

# AI (server only)
# Use an API key from a Google AI Studio project with billing NOT enabled.
# HeadsUp falls back to local rules if the free Gemini quota is unavailable/exhausted.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Keyless news discovery
SEARCH_COUNTRY=TR
SEARCH_LANG=tr

# Monitoring cadence
WATCH_SCAN_MINUTES=15
WATCH_SEARCH_RESULT_LIMIT=12
AI_IMPORTANCE_THRESHOLD=0.72

# Expo push service
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Mobile public config (copy relevant values into apps/mobile/.env)
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
EXPO_PUBLIC_EAS_PROJECT_ID=

# HeadsUp system alerts for free-tier policy changes
POLICY_MONITOR_ENABLED=true
POLICY_MONITOR_MINUTES=60

# Production serverless deployment
HEADSUP_SERVERLESS=0
HEADSUP_CRON_SECRET=change-me-with-another-long-random-secret
